        "NSLocationWhenInUseUsageDescription": "We use your location to help pick farm and warehouse locations on the map."
      },
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_API_KEY"
      }
    },
    "android": {
